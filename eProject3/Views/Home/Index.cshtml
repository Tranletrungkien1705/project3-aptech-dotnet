@{
    ViewData["Title"] = "Trang chủ";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Student Management System</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<style>
  :root { --brand:#4f46e5; --brand2:#7c3aed; --ink:#0f172a; --mut:#64748b; }
  * { box-sizing:border-box; }
  body { margin:0; color:var(--ink); background:#fff;
    font-family:"Sora",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
    -webkit-font-smoothing:antialiased; line-height:1.6; }
  a { text-decoration:none; }
  .wrap { max-width:1080px; margin:0 auto; padding:0 22px; }

  /* header */
  .nav { display:flex; align-items:center; justify-content:space-between; padding:18px 0; }
  .logo { display:flex; align-items:center; gap:10px; font-weight:800; font-size:18px; color:var(--ink); }
  .logo .mark { width:38px; height:38px; border-radius:11px; display:flex; align-items:center; justify-content:center;
    color:#fff; font-size:20px; background:linear-gradient(135deg,var(--brand),var(--brand2));
    box-shadow:0 6px 16px rgba(79,70,229,.4); }
  .btn { display:inline-flex; align-items:center; gap:8px; border-radius:10px; padding:11px 20px;
    font-weight:600; font-size:14.5px; transition:transform .15s ease, box-shadow .15s ease, filter .15s ease; }
  .btn.primary { background:linear-gradient(135deg,var(--brand),var(--brand2)); color:#fff;
    box-shadow:0 8px 22px rgba(79,70,229,.35); }
  .btn.primary:hover { transform:translateY(-2px); filter:brightness(1.05); }
  .btn.ghost { color:var(--brand); border:1px solid #e2e8f0; background:#fff; }
  .btn.ghost:hover { border-color:var(--brand); }

  /* hero */
  .hero { position:relative; overflow:hidden;
    background:
      radial-gradient(760px 420px at 82% -10%, rgba(124,58,237,.16), transparent 60%),
      radial-gradient(680px 380px at 8% 10%, rgba(79,70,229,.14), transparent 60%),
      #f8fafc;
    border-bottom:1px solid #eef2f7; }
  .hero-in { padding:72px 0 84px; text-align:center; }
  .pill { display:inline-flex; align-items:center; gap:7px; font-size:13px; font-weight:600; color:var(--brand);
    background:rgba(79,70,229,.1); border:1px solid rgba(79,70,229,.2); padding:6px 14px; border-radius:999px; }
  h1 { font-size:clamp(2rem,5vw,3.1rem); font-weight:800; letter-spacing:-.03em; margin:20px 0 14px; }
  h1 .grad { background:linear-gradient(135deg,var(--brand),var(--brand2)); -webkit-background-clip:text;
    background-clip:text; -webkit-text-fill-color:transparent; }
  .lead { color:var(--mut); font-size:clamp(1rem,2vw,1.15rem); max-width:60ch; margin:0 auto 30px; }
  .cta { display:flex; gap:12px; justify-content:center; flex-wrap:wrap; }
  .demo-hint { margin-top:18px; font-size:13px; color:var(--mut); }
  .demo-hint code { background:#eef2f7; padding:2px 7px; border-radius:5px; color:var(--ink); }

  /* features */
  .features { padding:66px 0; }
  .features h2 { text-align:center; font-size:1.7rem; font-weight:800; letter-spacing:-.02em; margin:0 0 8px; }
  .features .sub { text-align:center; color:var(--mut); margin:0 0 40px; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:18px; }
  .card { border:1px solid #eef2f7; border-radius:16px; padding:26px 22px; background:#fff;
    transition:transform .15s ease, box-shadow .15s ease, border-color .15s ease; }
  .card:hover { transform:translateY(-4px); box-shadow:0 16px 40px rgba(2,6,23,.09); border-color:#e2e8f0; }
  .card .ic { width:48px; height:48px; border-radius:13px; display:flex; align-items:center; justify-content:center;
    font-size:23px; color:var(--brand); background:rgba(79,70,229,.1); margin-bottom:16px; }
  .card h3 { font-size:1.08rem; font-weight:700; margin:0 0 6px; }
  .card p { color:var(--mut); font-size:14px; margin:0; }

  /* roles strip */
  .roles { background:#0f172a; color:#e2e8f0; padding:54px 0; }
  .roles h2 { text-align:center; font-size:1.5rem; font-weight:800; margin:0 0 6px; color:#fff; }
  .roles .sub { text-align:center; color:#94a3b8; margin:0 0 34px; }
  .rgrid { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:14px; }
  .role { background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.08); border-radius:13px;
    padding:20px; text-align:center; }
  .role i { font-size:26px; color:#a5b4fc; }
  .role .t { font-weight:700; margin-top:8px; }
  .role .d { font-size:12.5px; color:#94a3b8; margin-top:2px; }

  footer { text-align:center; padding:30px 0; color:var(--mut); font-size:13px; border-top:1px solid #eef2f7; }
</style>
</head>
<body>

<div class="hero">
  <div class="wrap">
    <div class="nav">
      <div class="logo"><span class="mark"><i class="bi bi-mortarboard-fill"></i></span> Student Management</div>
      <a class="btn primary" href="/Identity/Account/Login"><i class="bi bi-box-arrow-in-right"></i> Đăng nhập</a>
    </div>

    <div class="hero-in">
      <span class="pill"><i class="bi bi-stars"></i> Hệ thống quản lý học vụ &amp; cuộc thi mỹ thuật</span>
      <h1>Quản lý sinh viên &amp; cuộc thi<br /><span class="grad">gọn gàng, trực quan</span></h1>
      <p class="lead">Một nền tảng cho toàn bộ vòng đời học vụ: sinh viên, lớp học, môn học, cuộc thi &amp; triển lãm tranh —
        với phân quyền rõ ràng cho từng vai trò.</p>
      <div class="cta">
        <a class="btn primary" href="/Identity/Account/Login"><i class="bi bi-box-arrow-in-right"></i> Đăng nhập hệ thống</a>
        <a class="btn ghost" href="#features"><i class="bi bi-grid-1x2"></i> Tính năng</a>
      </div>
      <div class="demo-hint">Tài khoản demo: <code>admin@sms.com</code> / <code>Admin@123</code></div>
    </div>
  </div>
</div>

<section class="features" id="features">
  <div class="wrap">
    <h2>Tất cả trong một</h2>
    <p class="sub">Những gì hệ thống làm được</p>
    <div class="grid">
      <div class="card"><div class="ic"><i class="bi bi-people-fill"></i></div>
        <h3>Quản lý sinh viên</h3><p>Hồ sơ, lớp học, đăng ký môn học và theo dõi kết quả theo từng kỳ.</p></div>
      <div class="card"><div class="ic"><i class="bi bi-trophy-fill"></i></div>
        <h3>Cuộc thi mỹ thuật</h3><p>Tạo cuộc thi, nhận bài dự thi, chấm điểm và công bố kết quả minh bạch.</p></div>
      <div class="card"><div class="ic"><i class="bi bi-image-fill"></i></div>
        <h3>Triển lãm tranh</h3><p>Trưng bày các tác phẩm nổi bật, quản lý bộ sưu tập và tranh theo triển lãm.</p></div>
      <div class="card"><div class="ic"><i class="bi bi-mortarboard-fill"></i></div>
        <h3>Học vụ &amp; môn học</h3><p>Lớp, môn học, phân công giảng dạy và quản lý điểm số tập trung.</p></div>
    </div>
  </div>
</section>

<section class="roles">
  <div class="wrap">
    <h2>Phân quyền theo vai trò</h2>
    <p class="sub">Mỗi người chỉ thấy đúng phần việc của mình</p>
    <div class="rgrid">
      <div class="role"><i class="bi bi-shield-lock-fill"></i><div class="t">Admin</div><div class="d">Toàn quyền hệ thống</div></div>
      <div class="role"><i class="bi bi-clipboard-check-fill"></i><div class="t">Manager</div><div class="d">Quản lý cuộc thi &amp; triển lãm</div></div>
      <div class="role"><i class="bi bi-person-workspace"></i><div class="t">Staff</div><div class="d">Nghiệp vụ học vụ</div></div>
      <div class="role"><i class="bi bi-person-badge-fill"></i><div class="t">Student</div><div class="d">Dự thi &amp; xem kết quả</div></div>
    </div>
  </div>
</section>

<footer>
  © @DateTime.Now.Year Student Management System · Đồ án .NET · deploy 24/7 trên Render
</footer>

</body>
</html>
